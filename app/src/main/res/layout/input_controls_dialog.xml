<?xml version="1.0" encoding="utf-8"?>
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="330dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/SProfile"
                style="@style/ComboBox"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:spinnerMode="dialog"/>

            <ImageView
                android:id="@+id/BTSettings"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/icon_settings"
                app:tint="@color/colorPrimary" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/CBEnableQuickAccessPanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/enable_quick_access_panel"
            android:checked="false" />

        <CheckBox
            android:id="@+id/CBRelativeMouseMovement"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enable relative mouse movement"
            android:checked="false" />

        <CheckBox
            android:id="@+id/CBShowTouchscreenControls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/show_touchscreen_controls" />

        <CheckBox
            android:id="@+id/CBEnableTimeout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/enable_touchscreen_timeout"
            android:checked="false" />

        <CheckBox
            android:id="@+id/CBEnableHaptics"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/enable_touchscreen_haptics"
            android:checked="false" />

        <CheckBox
            android:id="@+id/CBEnableGyroscope"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/enable_gyroscope_control"
            android:checked="false" />

        <LinearLayout
            android:id="@+id/GyroscopeSensitivityLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gyroscope_sensitivity"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <com.google.android.material.slider.Slider
                android:id="@+id/SGyroscopeSensitivity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="0.1"
                android:valueTo="3.0"
                android:stepSize="0.1"
                android:value="1.0"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true" />

        </LinearLayout>

    </LinearLayout>
</HorizontalScrollView>