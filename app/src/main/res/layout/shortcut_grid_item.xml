<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="#1A1A2E"
    android:foreground="@drawable/modern_card_ripple"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Full-bleed portrait cover art (600x900 Steam capsule ratio ~= 228dp tall) -->
        <ImageView
            android:id="@+id/ImageView"
            android:layout_width="match_parent"
            android:layout_height="228dp"
            android:scaleType="centerCrop"
            android:background="#0D0D1A" />

        <!-- Gradient scrim: top strip for menu button visibility -->
        <View
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_gravity="top"
            android:background="@drawable/gradient_top_overlay" />

        <!-- Gradient scrim: bottom strip for text legibility -->
        <View
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_gravity="bottom"
            android:background="@drawable/gradient_bottom_overlay" />

        <!-- Title + container badge overlaid at bottom -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="48dp"
            android:paddingBottom="10dp">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/TVTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/TVSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="10sp"
                android:textColor="#BDFFFFFF"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/TVWineVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:textSize="9sp"
                android:textColor="#DDFFFFFF"
                android:background="@drawable/wine_version_badge_bg"
                android:visibility="gone" />

        </LinearLayout>

        <!-- 3-dot menu button — top right, always visible over art -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/BTMenu"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="end|top"
            android:layout_margin="2dp"
            app:icon="@drawable/icon_list_item_menu"
            app:iconTint="#FFFFFF"
            app:iconSize="20dp" />

    </FrameLayout>

</com.google.android.material.card.MaterialCardView>
