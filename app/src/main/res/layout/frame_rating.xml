<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fps_counter_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="2dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/FPSCounterCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#A8181818"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:cardPreventCornerOverlap="false"
        app:cardUseCompatPadding="false"
        app:strokeColor="#33FFFFFF"
        app:strokeWidth="1dp">

        <com.winlator.cmod.widget.FlowLayout
            android:id="@+id/FPSCounterContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingTop="7dp"
            android:paddingEnd="9dp"
            android:paddingBottom="7dp">

            <LinearLayout
                android:id="@+id/LayoutGPU"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:gravity="center_vertical"
                android:minHeight="18dp"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/TVGPULabel"
                    android:layout_width="34dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:layout_marginEnd="5dp"
                    android:maxLines="1"
                    android:text="GPU"
                    android:textColor="#19D07E"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/TVGPU"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:textColor="#F2F2F2"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="10dp"
                    android:background="#55FFFFFF"
                    android:tag="horizontal_separator"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/LayoutGPULoad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:gravity="center_vertical"
                android:minHeight="18dp"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/TVGPULoadLabel"
                    android:layout_width="34dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:layout_marginEnd="5dp"
                    android:maxLines="1"
                    android:text="GPU"
                    android:textColor="#19D07E"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/TVGPULoad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:textColor="#F2F2F2"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="10dp"
                    android:background="#55FFFFFF"
                    android:tag="horizontal_separator"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/LayoutRenderer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:gravity="center_vertical"
                android:minHeight="18dp"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/TVRendererLabel"
                    android:layout_width="34dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:layout_marginEnd="5dp"
                    android:maxLines="1"
                    android:text="API"
                    android:textColor="#F05A9D"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/TVRenderer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:textColor="#F2F2F2"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="10dp"
                    android:background="#55FFFFFF"
                    android:tag="horizontal_separator"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/LayoutGPUTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:gravity="center_vertical"
                android:minHeight="18dp"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/TVGPUTempLabel"
                    android:layout_width="34dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:layout_marginEnd="5dp"
                    android:maxLines="1"
                    android:text="GPU"
                    android:textColor="#19D07E"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/TVGPUTemp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:textColor="#F2F2F2"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="10dp"
                    android:background="#55FFFFFF"
                    android:tag="horizontal_separator"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/LayoutRAM"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:gravity="center_vertical"
                android:minHeight="18dp"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/TVRAMLabel"
                    android:layout_width="34dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:layout_marginEnd="5dp"
                    android:maxLines="1"
                    android:text="RAM"
                    android:textColor="#E556D8"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/TVRAM"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:textColor="#F2F2F2"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="10dp"
                    android:background="#55FFFFFF"
                    android:tag="horizontal_separator"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/LayoutCPULoad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:gravity="center_vertical"
                android:minHeight="18dp"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/TVCPULoadLabel"
                    android:layout_width="34dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:layout_marginEnd="5dp"
                    android:maxLines="1"
                    android:text="CPU"
                    android:textColor="#42B6FF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/TVCPULoad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:textColor="#F2F2F2"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="10dp"
                    android:background="#55FFFFFF"
                    android:tag="horizontal_separator"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/LayoutCPUTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:gravity="center_vertical"
                android:minHeight="18dp"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/TVCPUTempLabel"
                    android:layout_width="34dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:layout_marginEnd="5dp"
                    android:maxLines="1"
                    android:text="CPU"
                    android:textColor="#42B6FF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/TVCPUTemp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:textColor="#F2F2F2"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="10dp"
                    android:background="#55FFFFFF"
                    android:tag="horizontal_separator"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/LayoutBatteryTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:gravity="center_vertical"
                android:minHeight="18dp"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/TVBatteryTempLabel"
                    android:layout_width="34dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:layout_marginEnd="5dp"
                    android:maxLines="1"
                    android:text="BAT"
                    android:textColor="#A6E84B"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/TVBatteryTemp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:textColor="#F2F2F2"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="10dp"
                    android:background="#55FFFFFF"
                    android:tag="horizontal_separator"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/LayoutBatteryVoltage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:gravity="center_vertical"
                android:minHeight="18dp"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/TVBatteryVoltageLabel"
                    android:layout_width="34dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:layout_marginEnd="5dp"
                    android:maxLines="1"
                    android:text="PWR"
                    android:textColor="#F3DE47"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/TVBatteryVoltage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:textColor="#F2F2F2"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="10dp"
                    android:background="#55FFFFFF"
                    android:tag="horizontal_separator"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/LayoutFPS"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:gravity="center_vertical"
                android:minHeight="18dp"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/TVFPSLabel"
                    android:layout_width="34dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:layout_marginEnd="5dp"
                    android:maxLines="1"
                    android:text="FPS"
                    android:textColor="#FF5F73"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/TVFPS"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:text="0"
                    android:textColor="#F8F8F8"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="10dp"
                    android:background="#55FFFFFF"
                    android:tag="horizontal_separator"
                    android:visibility="gone" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/LayoutFrameTimeGraph"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="2dp"
                android:gravity="center_vertical"
                android:minHeight="18dp"
                android:orientation="horizontal">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/TVFrameTimeLabel"
                    android:layout_width="34dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:layout_marginEnd="5dp"
                    android:maxLines="1"
                    android:text="FT"
                    android:textColor="#FF5F73"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.winlator.cmod.widget.FrameTimeGraphView
                    android:id="@+id/FrameTimeGraphView"
                    android:layout_width="58dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="7dp" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/TVFrameTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:text="--"
                    android:textColor="#F8F8F8"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </com.winlator.cmod.widget.FlowLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
