<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="0dp"
    android:background="?android:attr/selectableItemBackground"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- Иконка драйвера -->

    <!-- Название драйвера -->

    <ImageView
        android:id="@+id/driverIcon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="0dp"
        android:src="@drawable/icon_snapdragon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/driverNameText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="3"
        android:text="Purple Turnip Driver v24.3.4"
        android:textColor="?attr/colorOnSurface"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/downloadButton"
        app:layout_constraintStart_toEndOf="@id/driverIcon"
        app:layout_constraintTop_toTopOf="@id/driverIcon" />

    <!-- Версия драйвера -->
    <TextView
        android:id="@+id/driverVersionText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Версия: v24.3.4"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="11sp"
        app:layout_constraintEnd_toStartOf="@id/downloadButton"
        app:layout_constraintStart_toEndOf="@id/driverIcon"
        app:layout_constraintTop_toBottomOf="@id/driverNameText" />

    <!-- Размер -->
    <TextView
        android:id="@+id/driverSizeText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="8dp"
        android:text="Размер: 12.5 MB"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="10sp"
        app:layout_constraintEnd_toStartOf="@id/downloadButton"
        app:layout_constraintStart_toEndOf="@id/driverIcon"
        app:layout_constraintTop_toBottomOf="@id/driverVersionText" />

    <!-- Дата публикации -->
    <TextView
        android:id="@+id/driverDateText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="8dp"
        android:text="Опубликовано: 25.08.2024"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="10sp"
        app:layout_constraintEnd_toStartOf="@id/downloadButton"
        app:layout_constraintStart_toEndOf="@id/driverIcon"
        app:layout_constraintTop_toBottomOf="@id/driverSizeText" />

    <!-- Описание драйвера - скрыто для экономии места -->
    <TextView
        android:id="@+id/driverDescriptionText"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@id/downloadButton"
        app:layout_constraintStart_toEndOf="@id/driverIcon"
        app:layout_constraintTop_toBottomOf="@id/driverDateText" />

    <!-- Кнопка загрузки -->
    <Button
        android:id="@+id/downloadButton"
        style="@style/ButtonNeutral"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:minWidth="0dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:text="@string/download"
        android:textSize="10sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/driverIcon" />

</androidx.constraintlayout.widget.ConstraintLayout>
