<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="?attr/colorSurfaceContainer"
    app:rippleColor="?attr/colorPrimary"
    app:strokeWidth="0dp"
    style="@style/Widget.Material3.CardView.Elevated">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Container Icon -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/containerIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/colorPrimaryContainer"
            android:scaleType="centerInside"
            android:src="@drawable/icon_action_bar_menu"
            app:tint="?attr/colorOnPrimaryContainer"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Small"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Container Name -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/containerName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:textAppearance="?attr/textAppearanceHeadline6"
            android:textColor="?attr/colorOnSurface"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Wine Container"
            app:layout_constraintStart_toEndOf="@id/containerIcon"
            app:layout_constraintEnd_toStartOf="@id/menuButton"
            app:layout_constraintTop_toTopOf="@id/containerIcon" />

        <!-- Container Description -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/containerDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:maxLines="2"
            android:ellipsize="end"
            tools:text="Windows applications container with DirectX support"
            app:layout_constraintStart_toEndOf="@id/containerIcon"
            app:layout_constraintEnd_toStartOf="@id/menuButton"
            app:layout_constraintTop_toBottomOf="@id/containerName" />

        <!-- Menu Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/menuButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            app:icon="@drawable/icon_action_bar_menu"
            app:iconTint="?attr/colorOnSurfaceVariant"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="24dp"
            app:cornerRadius="20dp"
            android:contentDescription="More options"
            style="@style/Widget.Material3.Button.TextButton"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/containerIcon" />

        <!-- Status Chips Container -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/statusChipGroup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            app:chipSpacingHorizontal="8dp"
            app:singleLine="true"
            app:layout_constraintStart_toEndOf="@id/containerIcon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/containerDescription">

            <!-- Status Chip -->
            <com.google.android.material.chip.Chip
                android:id="@+id/statusChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ready"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                app:chipBackgroundColor="?attr/colorSecondaryContainer"
                app:chipStrokeWidth="0dp"
                app:chipCornerRadius="12dp"
                app:chipMinHeight="24dp"
                style="@style/Widget.Material3.Chip.Filter" />

            <!-- Wine Version Chip -->
            <com.google.android.material.chip.Chip
                android:id="@+id/wineVersionChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wine 8.0"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                app:chipBackgroundColor="?attr/colorTertiaryContainer"
                app:chipStrokeWidth="0dp"
                app:chipCornerRadius="12dp"
                app:chipMinHeight="24dp"
                style="@style/Widget.Material3.Chip.Filter" />

        </com.google.android.material.chip.ChipGroup>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
