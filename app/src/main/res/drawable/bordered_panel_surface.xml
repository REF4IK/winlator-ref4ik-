<?xml version="1.0" encoding="utf-8"?>
<!--
    Hairline-bordered "surface" tile — matches the Stitch mockup's
    "1px solid #E1E3E1, no shadow" rule for per-core tiles, sub-cards, etc.
    Uses ?attr/colorOutlineVariant so it adapts to both light and dark themes.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="4dp" />
    <solid android:color="?attr/colorSurface" />
    <stroke android:width="1dp" android:color="?attr/colorOutlineVariant" />
</shape>
