<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E27">

    <!-- Animated Background -->
    <com.winlator.cmod.bigpicture.TiledBackgroundView
        android:id="@+id/parallaxBackgroundView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.4"/>

    <!-- Gradient Overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gradient_overlay"
        android:alpha="0.85"/>

    <!-- Main Horizontal Layout -->
    <LinearLayout
        android:id="@+id/mainLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="32dp"
        android:gravity="center_vertical">

        <!-- Left Side: Cover Art Section -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.4"
            android:layout_marginEnd="32dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="24dp"
            app:cardBackgroundColor="#1A1F3A">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Cover Art with Glow Effect -->

                <!-- Settings Button Overlay -->

                <ImageView
                    android:id="@+id/IVCoverArt"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:padding="24dp"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="16dp"
                    android:orientation="vertical"
                    android:gravity="center">

                    <ImageButton
                        android:id="@+id/settingsButton"
                        android:layout_width="49dp"
                        android:layout_height="20dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Settings"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:nextFocusRight="@id/playButton"
                        android:padding="14dp"
                        android:src="@drawable/icon_rb"
                        android:tint="#FFFFFF" />

                    <TextView
                        android:id="@+id/settingsLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Settings"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <androidx.cardview.widget.CardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="50dp"
                        app:cardElevation="12dp"
                        app:cardBackgroundColor="#2A3254">

                    </androidx.cardview.widget.CardView>

                </LinearLayout>

            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- Right Side: Content Section -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.6"
            android:orientation="vertical">

            <!-- Top Section: Title & Stats Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="16dp"
                app:cardBackgroundColor="#1A1F3A"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="28dp">

                    <!-- Game Title with Modern Typography -->

                    <TextView
                        android:id="@+id/TVGameTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.02"
                        android:shadowColor="#4A5FFF"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:shadowRadius="20"
                        android:text="Game Title"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <!-- Divider Line -->
                    <View
                        android:layout_width="80dp"
                        android:layout_height="4dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:background="#4A5FFF" />

                    <!-- Stats Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start"
                        android:orientation="horizontal">

                        <!-- Play Count Badge -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="32dp"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/TVPlayCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="0 plays"
                                android:textColor="#6C7EFF"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:letterSpacing="0.15"
                                android:text="SESSIONS"
                                android:textColor="#5A6B8C"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <!-- Play Time Badge -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/TVPlaytime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="sans-serif-medium"
                                android:text="0h 0m"
                                android:textColor="#FF6C9D"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:letterSpacing="0.15"
                                android:text="PLAYTIME"
                                android:textColor="#5A6B8C"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <WebView
                        android:id="@+id/webView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:alpha="0"
                        android:clickable="false"
                        android:focusable="false"
                        android:focusableInTouchMode="false" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Action Buttons Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="24dp">

                <!-- Play Button - Hero Style -->
                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="50dp"
                    app:cardElevation="20dp"
                    app:cardBackgroundColor="#00000000"
                    android:layout_marginEnd="20dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/circular_button_green"
                        android:gravity="center"
                        android:paddingStart="32dp"
                        android:paddingEnd="40dp"
                        android:paddingTop="20dp"
                        android:paddingBottom="20dp">

                        <ImageButton
                            android:id="@+id/playButton"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/icon_play"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:tint="#FFFFFF"
                            android:padding="10dp"
                            android:contentDescription="Play"
                            android:focusable="true"
                            android:focusableInTouchMode="true"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PLAY NOW"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-black"
                            android:letterSpacing="0.1"
                            android:layout_marginStart="12dp"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Settings Button - Secondary Style -->
                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="50dp"
                    app:cardElevation="12dp"
                    app:cardBackgroundColor="#2A3254">

                </androidx.cardview.widget.CardView>

                <ImageButton
                    android:id="@+id/shortcutSettingsButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Configure"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:padding="18dp"
                    android:src="@drawable/icon_settings"
                    android:tint="#6C7EFF" />
            </LinearLayout>

            <!-- RecyclerView - Games Carousel -->

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/RecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:overScrollMode="never"
                android:padding="16dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:cardCornerRadius="20dp"
                app:cardElevation="16dp"
                app:cardBackgroundColor="#1A1F3A">

            </androidx.cardview.widget.CardView>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Empty State Message -->
                <TextView
                    android:id="@+id/TVEmptyState"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:padding="16dp"
                    android:text="Nothing here. Launch your container and create a Shortcut to get started!"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

    </LinearLayout>

    <!-- Hidden System Fields -->
    <TextView android:id="@+id/TVGraphicsDriver" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <TextView android:id="@+id/TVGraphicsDriverVersion" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <TextView android:id="@+id/TVDXWrapper" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <TextView android:id="@+id/TVDXWrapperConfig" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <TextView android:id="@+id/TVAudioDriver" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
    <TextView android:id="@+id/TVBox64Preset" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>

    <!-- Modern Settings Panel -->
    <LinearLayout
        android:id="@+id/settingsLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#0A0E27"
        android:visibility="gone">

        <!-- Settings Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp"
            android:background="@drawable/gradient_overlay">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙️ Settings"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:layout_centerVertical="true"/>

            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                app:cardCornerRadius="50dp"
                app:cardElevation="12dp"
                app:cardBackgroundColor="#2A3254">

                <ImageButton
                    android:id="@+id/backButton"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/icon_rb"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:tint="#FFFFFF"
                    android:padding="14dp"
                    android:contentDescription="Back"
                    android:focusable="true"
                    android:focusableInTouchMode="true"/>
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/backLabel"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"/>
        </RelativeLayout>

        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Music Settings Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="16dp"
                    app:cardBackgroundColor="#1A1F3A"
                    android:layout_marginBottom="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <!-- Section Header -->
                        <TextView
                            android:id="@+id/TVSettingsLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎵 Background Music"
                            android:textColor="#FFFFFF"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginBottom="20dp"/>

                        <!-- YouTube URL -->
                        <TextView
                            android:id="@+id/youtubeUrlLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="YouTube Video URL"
                            android:textColor="#6C7EFF"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Not all YouTube videos are supported"
                            android:textColor="#5A6B8C"
                            android:textSize="12sp"
                            android:layout_marginBottom="12dp"/>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="24dp">

                            <com.google.android.material.textfield.TextInputLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="12dp"
                                android:hint="Enter YouTube URL"
                                app:boxBackgroundColor="#2A3254"
                                app:boxCornerRadiusTopStart="12dp"
                                app:boxCornerRadiusTopEnd="12dp"
                                app:boxCornerRadiusBottomStart="12dp"
                                app:boxCornerRadiusBottomEnd="12dp">

                                <EditText
                                    android:id="@+id/youtubeUrlInput"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="text"
                                    android:textColor="#FFFFFF"
                                    android:textSize="14sp"
                                    android:padding="16dp"/>
                            </com.google.android.material.textfield.TextInputLayout>

                            <Button
                                android:id="@+id/loadVideoButton"
                                android:layout_width="wrap_content"
                                android:layout_height="56dp"
                                android:text="Set Music"
                                android:textColor="#FFFFFF"
                                android:backgroundTint="#4A5FFF"
                                android:paddingStart="20dp"
                                android:paddingEnd="20dp"/>
                        </LinearLayout>

                        <!-- Music Source Selection -->
                        <TextView
                            android:id="@+id/musicSourceLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Music Source"
                            android:textColor="#6C7EFF"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"
                            android:layout_marginBottom="12dp"/>

                        <RadioGroup
                            android:id="@+id/musicSourceGroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="20dp">

                            <RadioButton
                                android:id="@+id/youtubeRadioButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="YouTube"
                                android:textColor="#FFFFFF"
                                android:checked="true"
                                android:buttonTint="#6C7EFF"/>

                            <RadioButton
                                android:id="@+id/mp3RadioButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="MP3 File"
                                android:textColor="#FFFFFF"
                                android:buttonTint="#6C7EFF"/>
                        </RadioGroup>

                        <!-- Action Buttons Grid -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center">

                            <Button
                                android:id="@+id/selectMp3Button"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Select MP3"
                                android:textColor="#FFFFFF"
                                android:backgroundTint="#2A3254"
                                android:layout_marginEnd="8dp"/>

                            <Button
                                android:id="@+id/resetMp3Button"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Reset MP3"
                                android:textColor="#FFFFFF"
                                android:backgroundTint="#2A3254"
                                android:layout_marginEnd="8dp"/>

                            <Button
                                android:id="@+id/disableBgMusicButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Disable"
                                android:textColor="#FFFFFF"
                                android:backgroundTint="#FF4757"/>
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Background Settings Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="16dp"
                    app:cardBackgroundColor="#1A1F3A"
                    android:layout_marginBottom="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <!-- Section Header -->
                        <TextView
                            android:id="@+id/themeLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎨 Background Theme"
                            android:textColor="#FFFFFF"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            android:layout_marginBottom="20dp"/>

                        <!-- Animation Type -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Animation Style"
                            android:textColor="#6C7EFF"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"
                            android:layout_marginBottom="12dp"/>

                        <RadioGroup
                            android:id="@+id/animationSelectorGroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginBottom="20dp">

                            <RadioButton
                                android:id="@+id/rbCustomWallpaper"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="🖼️ Custom Wallpaper"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:buttonTint="#6C7EFF"
                                android:padding="12dp"/>

                            <Button
                                android:id="@+id/selectWallpaperButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Select Wallpaper"
                                android:backgroundTint="#2A3254"
                                android:textColor="#FFFFFF"
                                android:layout_marginTop="8dp"
                                android:layout_marginBottom="8dp"
                                android:visibility="gone"/>

                            <RadioButton
                                android:id="@+id/rbNoAnimation"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="⬛ No Background"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:buttonTint="#6C7EFF"
                                android:padding="12dp"/>

                            <RadioButton
                                android:id="@+id/rbDefaultAnimation"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="🌊 Wave Animation"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:buttonTint="#6C7EFF"
                                android:padding="12dp"/>

                            <RadioButton
                                android:id="@+id/rbGearAnimation"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="⚙️ Gear Animation"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:buttonTint="#6C7EFF"
                                android:padding="12dp"/>

                            <RadioButton
                                android:id="@+id/rbQuiltAnimation"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="🔲 Quilt Pattern"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:buttonTint="#6C7EFF"
                                android:padding="12dp"/>

                            <RadioButton
                                android:id="@+id/rbFolderAnimation"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="📁 Custom Folder"
                                android:textColor="#FFFFFF"
                                android:textSize="16sp"
                                android:buttonTint="#6C7EFF"
                                android:padding="12dp"/>
                        </RadioGroup>

                        <Button
                            android:id="@+id/selectPngFolderButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="📂 Select Animation Folder (PNG)"
                            android:backgroundTint="#2A3254"
                            android:textColor="#FFFFFF"
                            android:layout_marginBottom="24dp"/>

                        <!-- Parallax Speed -->
                        <TextView
                            android:id="@+id/parallaxModeLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Parallax Speed"
                            android:textColor="#6C7EFF"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"
                            android:layout_marginBottom="12dp"/>

                        <RadioGroup
                            android:id="@+id/parallaxModeGroup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="24dp">

                            <RadioButton
                                android:id="@+id/rbParallaxOff"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Off"
                                android:textColor="#FFFFFF"
                                android:buttonTint="#6C7EFF"
                                android:gravity="center"/>

                            <RadioButton
                                android:id="@+id/rbParallaxSlow"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Slow"
                                android:textColor="#FFFFFF"
                                android:buttonTint="#6C7EFF"
                                android:gravity="center"/>

                            <RadioButton
                                android:id="@+id/rbParallaxDefault"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Default"
                                android:textColor="#FFFFFF"
                                android:buttonTint="#6C7EFF"
                                android:gravity="center"
                                android:checked="true"/>

                            <RadioButton
                                android:id="@+id/rbParallaxFast"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Fast"
                                android:textColor="#FFFFFF"
                                android:buttonTint="#6C7EFF"
                                android:gravity="center"/>
                        </RadioGroup>

                        <!-- Animation Speed Slider -->
                        <TextView
                            android:id="@+id/frameSpeedLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Animation Speed"
                            android:textColor="#6C7EFF"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"
                            android:layout_marginBottom="12dp"/>

                        <SeekBar
                            android:id="@+id/frameSpeedSeekBar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:max="100"
                            android:progress="66"
                            android:progressTint="#6C7EFF"
                            android:thumbTint="#FF6C9D"
                            android:progressBackgroundTint="#2A3254"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</FrameLayout>
